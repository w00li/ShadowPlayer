<Page
    x:Class="M3uPlayer.App.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:M3uPlayer.App.ViewModels"
    xmlns:local="using:M3uPlayer.App.Views"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="PaneCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>

        <Style x:Key="RowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:CategoryItem">
            <Grid ColumnSpacing="8" Height="36" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChannelTemplate" x:DataType="vm:ChannelRow">
            <Grid Height="72" ColumnSpacing="12" Background="Transparent"
                  PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="RowMenu_Opening">
                        <MenuFlyoutItem Click="RowMenu_Favorite" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:ChannelLogo Row="{x:Bind}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Visibility="{x:Bind IsPlaying, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                    <TextBlock Text="{x:Bind NowTitle, Mode=OneWay}" Visibility="{x:Bind HasNow, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="Brak EPG" Visibility="{x:Bind NoEpg, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind HasNow, Mode=OneWay}"
                                 Margin="0,3,0,3" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind NextText, Mode=OneWay}" Visibility="{x:Bind HasNext, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Tag="{x:Bind}" Opacity="{x:Bind StarOpacity, Mode=OneWay}" Click="Star_Click" GotFocus="Star_GotFocus" LostFocus="Star_LostFocus"
                        ToolTipService.ToolTip="{x:Bind StarTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind StarName, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind StarGlyph, Mode=OneWay}" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideTemplate" x:DataType="vm:GuideItem">
            <Grid MinHeight="{x:Bind RowHeight}" Background="Transparent">
                <TextBlock Text="{x:Bind Header}" Visibility="{x:Bind IsHeader}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Visibility="{x:Bind IsProgramme}" Opacity="{x:Bind TextOpacity, Mode=OneWay}" ColumnSpacing="12" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind TimeText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}" TextWrapping="Wrap" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind IsCurrent, Mode=OneWay}"
                                     AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid SizeChanged="Page_SizeChanged">
        <StackPanel Visibility="{x:Bind Vm.ShowEmpty, Mode=OneWay}" MaxWidth="460" Spacing="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Nie masz jeszcze żadnej listy" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="Dodaj listę M3U z adresu internetowego albo z pliku, a kanały pojawią się tutaj."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Po dodaniu listy możesz dodać też źródło EPG w Ustawieniach, żeby zobaczyć ramówkę."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Dodaj listę" Style="{ThemeResource AccentButtonStyle}" Click="AddPlaylist_Click" />
        </StackPanel>

        <Grid x:Name="Layout" Visibility="{x:Bind Vm.ShowLayout, Mode=OneWay}" Padding="16,4,16,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="200" />
                <ColumnDefinition x:Name="ChannelColumn" Width="320" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Kategorie -->
            <Border x:Name="CategoryCard" Style="{StaticResource PaneCardStyle}">
                <Grid RowSpacing="4" Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kategorie" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="12,0,12,4" />
                    <ListView x:Name="CategoryList" Grid.Row="1" ItemsSource="{x:Bind Vm.Categories}" ItemTemplate="{StaticResource CategoryTemplate}"
                              ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Single"
                              SelectedItem="{x:Bind Vm.SelectedCategory, Mode=OneWay}" SelectionChanged="CategoryList_SelectionChanged"
                              AutomationProperties.Name="Kategorie" />
                </Grid>
            </Border>

            <!-- Kanały -->
            <Border Grid.Column="1" Style="{StaticResource PaneCardStyle}">
                <Grid RowSpacing="8" Padding="8,8,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CategoryToggle" Width="32" Height="32" Padding="0" Click="CategoryToggle_Click"
                                ToolTipService.ToolTip="Pokaż lub ukryj kategorie" AutomationProperties.Name="Pokaż lub ukryj kategorie">
                            <FontIcon Glyph="&#xE700;" FontSize="14" />
                        </Button>
                        <TextBox Grid.Column="1" Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Szukaj kanału lub programu" AutomationProperties.Name="Szukaj kanału lub programu" />
                    </Grid>
                    <ComboBox x:Name="CategoryCombo" Grid.Row="1" HorizontalAlignment="Stretch" Visibility="Collapsed"
                              ItemsSource="{x:Bind Vm.Categories}" DisplayMemberPath="Name" SelectedItem="{x:Bind Vm.SelectedCategory, Mode=OneWay}"
                              SelectionChanged="CategoryCombo_SelectionChanged" AutomationProperties.Name="Kategoria" />
                    <ListView x:Name="ChannelList" Grid.Row="2" SingleSelectionFollowsFocus="False" ItemsSource="{x:Bind Vm.Channels}" ItemTemplate="{StaticResource ChannelTemplate}"
                              ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Single"
                              ContainerContentChanging="ChannelList_ContainerContentChanging" SelectionChanged="ChannelList_SelectionChanged"
                              AutomationProperties.Name="Kanały" />
                    <StackPanel Grid.Row="2" Visibility="{x:Bind Vm.HasListMessage, Mode=OneWay}" Spacing="12" Padding="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.ListMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="Wyczyść" HorizontalAlignment="Center" Visibility="{x:Bind Vm.CanClearSearch, Mode=OneWay}" Click="ClearSearch_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Obraz i ramówka -->
            <Grid x:Name="RightColumn" Grid.Column="2" RowSpacing="8" SizeChanged="RightColumn_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="VideoBox" Background="Black" CornerRadius="{ThemeResource OverlayCornerRadius}" Height="260">
                    <vlc:VideoView x:Name="Video" />
                    <Grid x:Name="Overlay" Visibility="{x:Bind Vm.OverlayVisible, Mode=OneWay}" RequestedTheme="Dark">
                        <Rectangle Fill="Black" Opacity="{x:Bind Vm.OverlayDim, Mode=OneWay}" />
                        <StackPanel Spacing="12" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <ProgressRing Width="40" Height="40" IsActive="{x:Bind Vm.ShowSpinner, Mode=OneWay}"
                                          Visibility="{x:Bind Vm.ShowSpinner, Mode=OneWay}" AutomationProperties.Name="Łączenie" />
                            <TextBlock Text="{x:Bind Vm.OverlayText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                            <Button Content="{x:Bind Vm.ButtonText, Mode=OneWay}" Visibility="{x:Bind Vm.ShowButton, Mode=OneWay}"
                                    HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="Retry_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource PaneCardStyle}">
                    <Grid RowSpacing="8" Padding="12,12,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Ramówka" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.GuideTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <ListView x:Name="GuideList" Grid.Row="1" ItemsSource="{x:Bind Vm.Guide}" ItemTemplate="{StaticResource GuideTemplate}"
                                  ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Single"
                                  ContainerContentChanging="GuideList_ContainerContentChanging" SelectionChanged="GuideList_SelectionChanged"
                                  AutomationProperties.Name="Ramówka" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Vm.GuideMessage, Mode=OneWay}" Visibility="{x:Bind Vm.HasGuideMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Grid.Row="2" Visibility="{x:Bind Vm.DetailVisible, Mode=OneWay}" MaxHeight="150"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="DetailPicture" Width="120" Height="68" Stretch="UniformToFill" VerticalAlignment="Top"
                                       Visibility="Collapsed" ImageFailed="DetailPicture_Failed" />
                                <ScrollViewer Grid.Column="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Vm.DetailTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Vm.DetailMeta, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Vm.DetailDescription, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
