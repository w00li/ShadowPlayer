<Page
    x:Class="M3uPlayer.App.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24">
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" MaxWidth="460" Spacing="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Nie masz jeszcze żadnej listy" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="Dodaj listę M3U z adresu internetowego albo z pliku, a kanały pojawią się tutaj."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Po dodaniu listy możesz dodać też źródło EPG w Ustawieniach, żeby zobaczyć ramówkę."
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Dodaj listę" Style="{ThemeResource AccentButtonStyle}" Click="AddPlaylist_Click" />
        </StackPanel>
        <TextBlock x:Name="CountText" Visibility="Collapsed" VerticalAlignment="Top" Style="{ThemeResource BodyTextBlockStyle}" />
    </Grid>
</Page>
