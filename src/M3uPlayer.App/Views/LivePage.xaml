<Page
    x:Class="M3uPlayer.App.Views.LivePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:M3uPlayer.App"
    xmlns:vm="using:M3uPlayer.App.ViewModels"
    xmlns:local="using:M3uPlayer.App.Views"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    NavigationCacheMode="Required">
    <Page.Resources>
        <Style x:Key="PaneCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>

        <Style x:Key="BarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="RowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="12,0,8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="CategoryTemplate" x:DataType="vm:CategoryItem">
            <Grid ColumnSpacing="8" Height="36" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Text="{x:Bind CountText, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChannelTemplate" x:DataType="vm:ChannelRow">
            <Grid Height="72" ColumnSpacing="12" Background="Transparent"
                  PointerEntered="Row_PointerEntered" PointerExited="Row_PointerExited">
                <Grid.ContextFlyout>
                    <MenuFlyout Opening="RowMenu_Opening">
                        <MenuFlyoutItem Click="RowMenu_Favorite" />
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:ChannelLogo Row="{x:Bind}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE768;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Visibility="{x:Bind IsPlaying, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                    <TextBlock Text="{x:Bind NowTitle, Mode=OneWay}" Visibility="{x:Bind HasNow, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{l:Tr Key=Live_NoEpg}" Visibility="{x:Bind NoEpg, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind HasNow, Mode=OneWay}"
                                 Margin="0,3,0,3" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{x:Bind NextText, Mode=OneWay}" Visibility="{x:Bind HasNext, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Width="32" Height="32" Padding="0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Tag="{x:Bind}" Opacity="{x:Bind StarOpacity, Mode=OneWay}" Click="Star_Click" GotFocus="Star_GotFocus" LostFocus="Star_LostFocus"
                        ToolTipService.ToolTip="{x:Bind StarTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind StarName, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind StarGlyph, Mode=OneWay}" FontSize="14" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideTemplate" x:DataType="vm:GuideItem">
            <Grid MinHeight="{x:Bind RowHeight}" Background="Transparent">
                <TextBlock Text="{x:Bind Header}" Visibility="{x:Bind IsHeader}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid Visibility="{x:Bind IsProgramme}" Opacity="{x:Bind TextOpacity, Mode=OneWay}" ColumnSpacing="12" Padding="0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind TimeText}" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" Spacing="4">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Title}" FontWeight="{x:Bind TitleWeight, Mode=OneWay}" TextWrapping="Wrap" />
                            <FontIcon Grid.Column="1" Glyph="&#xE81C;" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{x:Bind ReplayMarker, Mode=OneWay}"
                                      ToolTipService.ToolTip="{l:Tr Key=Live_InArchive}" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="1" Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind IsCurrent, Mode=OneWay}"
                                     AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid SizeChanged="Page_SizeChanged">
        <StackPanel Visibility="{x:Bind Vm.ShowEmpty, Mode=OneWay}" MaxWidth="460" Spacing="12" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{l:Tr Key=Live_NoListTitle}" Style="{ThemeResource TitleTextBlockStyle}" TextWrapping="Wrap" />
            <TextBlock Text="{l:Tr Key=Live_NoListBody}"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{l:Tr Key=Live_NoListEpgHint}"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="{l:Tr Key=Live_AddList}" Style="{ThemeResource AccentButtonStyle}" Click="AddPlaylist_Click" />
        </StackPanel>

        <Grid x:Name="Layout" Visibility="{x:Bind Vm.ShowLayout, Mode=OneWay}" Padding="16,4,16,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="200" />
                <ColumnDefinition x:Name="ChannelColumn" Width="320" />
                <ColumnDefinition Width="*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- Kategorie -->
            <Border x:Name="CategoryCard" Style="{StaticResource PaneCardStyle}">
                <Grid RowSpacing="4" Padding="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Key=Live_Categories}" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="12,0,12,4" />
                    <ListView x:Name="CategoryList" Grid.Row="1" ItemsSource="{x:Bind Vm.Categories}" ItemTemplate="{StaticResource CategoryTemplate}"
                              ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Single"
                              SelectedItem="{x:Bind Vm.SelectedCategory, Mode=OneWay}" SelectionChanged="CategoryList_SelectionChanged"
                              AutomationProperties.Name="{l:Tr Key=Live_Categories}" />
                </Grid>
            </Border>

            <!-- Kanały -->
            <Border x:Name="ChannelCard" Grid.Column="1" Style="{StaticResource PaneCardStyle}">
                <Grid RowSpacing="8" Padding="8,8,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CategoryToggle" Width="32" Height="32" Padding="0" Click="CategoryToggle_Click"
                                ToolTipService.ToolTip="{l:Tr Key=Live_ToggleCategories}" AutomationProperties.Name="{l:Tr Key=Live_ToggleCategories}">
                            <FontIcon Glyph="&#xE8A0;" FontSize="14" />
                        </Button>
                        <TextBox Grid.Column="1" Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{l:Tr Key=Live_Search}" AutomationProperties.Name="{l:Tr Key=Live_Search}" />
                    </Grid>
                    <ComboBox x:Name="CategoryCombo" Grid.Row="1" HorizontalAlignment="Stretch" Visibility="Collapsed"
                              ItemsSource="{x:Bind Vm.Categories}" DisplayMemberPath="Name" SelectedItem="{x:Bind Vm.SelectedCategory, Mode=OneWay}"
                              SelectionChanged="CategoryCombo_SelectionChanged" AutomationProperties.Name="{l:Tr Key=Live_Category}" />
                    <ListView x:Name="ChannelList" Grid.Row="2" SingleSelectionFollowsFocus="False" ItemsSource="{x:Bind Vm.Channels}" ItemTemplate="{StaticResource ChannelTemplate}"
                              ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Single"
                              ContainerContentChanging="ChannelList_ContainerContentChanging" IsItemClickEnabled="True" ItemClick="ChannelList_ItemClick"
                              AutomationProperties.Name="{l:Tr Key=Live_Channels}" />
                    <StackPanel Grid.Row="2" Visibility="{x:Bind Vm.HasListMessage, Mode=OneWay}" Spacing="12" Padding="16"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Vm.ListMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="{l:Tr Key=Live_Clear}" HorizontalAlignment="Center" Visibility="{x:Bind Vm.CanClearSearch, Mode=OneWay}" Click="ClearSearch_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Obraz i ramówka -->
            <Grid x:Name="RightColumn" Grid.Column="2" RowSpacing="8" SizeChanged="RightColumn_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="VideoRow" Height="Auto" />
                    <RowDefinition x:Name="GuideRow" Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="GuideCard" Grid.Row="1" Style="{StaticResource PaneCardStyle}">
                    <Grid RowSpacing="8" Padding="12,12,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{l:Tr Key=Live_Guide}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Vm.GuideTitle, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <ListView x:Name="GuideList" Grid.Row="1" DoubleTapped="GuideList_DoubleTapped" ItemsSource="{x:Bind Vm.Guide.Items}" ItemTemplate="{StaticResource GuideTemplate}"
                                  ItemContainerStyle="{StaticResource RowItemStyle}" SelectionMode="Single"
                                  ContainerContentChanging="GuideList_ContainerContentChanging" SelectionChanged="GuideList_SelectionChanged"
                                  AutomationProperties.Name="{l:Tr Key=Live_Guide}" />
                        <TextBlock Grid.Row="1" Text="{x:Bind Vm.Guide.Message, Mode=OneWay}" Visibility="{x:Bind Vm.Guide.HasMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Border Grid.Row="2" Visibility="{x:Bind Vm.Guide.DetailVisible, Mode=OneWay}" MaxHeight="190"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}" Padding="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="DetailPicture" Width="120" Height="68" Stretch="UniformToFill" VerticalAlignment="Top"
                                       Visibility="Collapsed" ImageFailed="DetailPicture_Failed" />
                                <ScrollViewer Grid.Column="1">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Vm.Guide.DetailTitle, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Vm.Guide.DetailMeta, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <Button Content="{l:Tr Key=Live_WatchFromStart}" Margin="0,4,0,0" Click="Replay_Click"
                                                Visibility="{x:Bind Vm.Guide.ReplayVisible, Mode=OneWay}" IsEnabled="{x:Bind Vm.Guide.CanReplay, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind Vm.Guide.ReplayNote, Mode=OneWay}" Visibility="{x:Bind Vm.Guide.HasReplayNote, Mode=OneWay}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Vm.Guide.DetailDescription, Mode=OneWay}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Obraz: po ramówce w kolejności XAML, więc Tab trafia na niego po ramówce -->
                <ContentControl x:Name="VideoHost" IsTabStop="True" UseSystemFocusVisuals="True" Padding="0" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" VerticalAlignment="Top" GotFocus="VideoHost_GotFocus" AutomationProperties.Name="{l:Tr Key=Live_Video}">
                <Grid x:Name="VideoBox" Background="Black" CornerRadius="{ThemeResource OverlayCornerRadius}" Height="260"
                      PointerMoved="Video_PointerMoved" Tapped="Video_Tapped" DoubleTapped="Video_DoubleTapped">
                    <vlc:VideoView x:Name="Video" />
                    <Grid x:Name="Overlay" Visibility="{x:Bind Vm.Overlay.Visible, Mode=OneWay}" RequestedTheme="Dark">
                        <Rectangle Fill="Black" Opacity="{x:Bind Vm.Overlay.Dim, Mode=OneWay}" />
                        <StackPanel Spacing="12" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                            <ProgressRing Width="40" Height="40" IsActive="{x:Bind Vm.Overlay.Spinner, Mode=OneWay}"
                                          Visibility="{x:Bind Vm.Overlay.Spinner, Mode=OneWay}" AutomationProperties.Name="{l:Tr Key=Live_Connecting}" />
                            <TextBlock Text="{x:Bind Vm.Overlay.Text, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="OverlayButton" Content="{x:Bind Vm.Overlay.ButtonText, Mode=OneWay}" Visibility="{x:Bind Vm.Overlay.Button, Mode=OneWay}"
                                    HorizontalAlignment="Center" Style="{ThemeResource AccentButtonStyle}" Click="Retry_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Pasek sterowania: nad dolną krawędzią obrazu -->
                    <Grid x:Name="ControlsBar" VerticalAlignment="Bottom" RequestedTheme="Dark">
                        <Rectangle Fill="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.88" />
                        <StackPanel Spacing="2" Padding="12,6,12,6">
                            <StackPanel Visibility="{x:Bind Vm.Archive.Active, Mode=OneWay}" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Vm.Archive.Caption, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="420" />
                                    <TextBlock Text="{l:Tr Key=Live_AtRecordingEnd}" Visibility="{x:Bind Vm.Archive.AtLiveEnd, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Vm.Archive.ElapsedText, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" IsThumbToolTipEnabled="False" ValueChanged="Timeline_ValueChanged"
                                            AutomationProperties.Name="{l:Tr Key=Live_ProgrammePosition}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Vm.Archive.TotalText, Mode=OneWay}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>
                            </StackPanel>
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BarButtonStyle}" Click="PlayPause_Click"
                                        ToolTipService.ToolTip="{x:Bind Vm.PlayTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind Vm.PlayName, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind Vm.PlayGlyph, Mode=OneWay}" FontSize="16" />
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource BarButtonStyle}" Click="Mute_Click"
                                        ToolTipService.ToolTip="{x:Bind Vm.MuteTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind Vm.MuteName, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind Vm.MuteGlyph, Mode=OneWay}" FontSize="16" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Grid.Column="2" Width="100" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                        Value="{x:Bind Vm.Volume, Mode=TwoWay}" AutomationProperties.Name="{l:Tr Key=Live_Volume}" />
                                <Button Grid.Column="4" Content="{l:Tr Key=Live_BackToLive}" Click="GoLive_Click" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Visibility="{x:Bind Vm.Archive.Active, Mode=OneWay}" />
                                <Button x:Name="AudioButton" Grid.Column="5" Style="{StaticResource BarButtonStyle}" IsEnabled="False"
                                        ToolTipService.ToolTip="{l:Tr Key=Live_AudioTrack}" AutomationProperties.Name="{l:Tr Key=Live_AudioTrack}">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="AudioMenu" Placement="TopEdgeAlignedRight" Opening="AudioMenu_Opening" Opened="Menu_Opened" Closed="Menu_Closed" />
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="SubtitleButton" Grid.Column="6" Style="{StaticResource BarButtonStyle}" IsEnabled="False"
                                        ToolTipService.ToolTip="{l:Tr Key=Live_Subtitles}" AutomationProperties.Name="{l:Tr Key=Live_Subtitles}">
                                    <FontIcon Glyph="&#xE7F0;" FontSize="16" />
                                    <Button.Flyout>
                                        <MenuFlyout x:Name="SubtitleMenu" Placement="TopEdgeAlignedRight" Opening="SubtitleMenu_Opening" Opened="Menu_Opened" Closed="Menu_Closed" />
                                    </Button.Flyout>
                                </Button>
                                <Button x:Name="FullscreenButton" Grid.Column="7" Style="{StaticResource BarButtonStyle}" Click="Fullscreen_Click"
                                        ToolTipService.ToolTip="{l:Tr Key=Live_FullScreenKey}" AutomationProperties.Name="{l:Tr Key=Live_FullScreen}">
                                    <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
                </ContentControl>

            </Grid>
        </Grid>
    </Grid>
</Page>
