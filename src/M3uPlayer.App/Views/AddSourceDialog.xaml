<ContentDialog
    x:Class="M3uPlayer.App.Views.AddSourceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:M3uPlayer.App"
    PrimaryButtonText="{l:Tr Key=AddSource_Add}"
    CloseButtonText="{l:Tr Key=AddSource_Cancel}"
    DefaultButton="Primary"
    PrimaryButtonClick="Primary_Click">
    <StackPanel Spacing="12" MinWidth="420">
        <TextBox x:Name="UrlBox" Header="{l:Tr Key=AddSource_WebAddress}" PlaceholderText="https://…" LostFocus="UrlBox_LostFocus"
                 TextChanged="UrlBox_TextChanged" />
        <TextBlock x:Name="UrlError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBlock Text="{l:Tr Key=AddSource_Or}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="PickButton" Content="{l:Tr Key=AddSource_PickFile}" Click="Pick_Click" />
            <TextBlock x:Name="FileText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <TextBlock x:Name="FileError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        <TextBox x:Name="NameBox" Header="{l:Tr Key=AddSource_Name}" TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="NameError" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
    </StackPanel>
</ContentDialog>
