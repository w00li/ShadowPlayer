<UserControl
    x:Class="M3uPlayer.App.Views.ChannelLogo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="{x:Bind Side}" Height="{x:Bind Side}" CornerRadius="{ThemeResource ControlCornerRadius}"
            Background="{ThemeResource ControlSolidFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
            <TextBlock x:Name="InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Image x:Name="Picture" Margin="4" Stretch="Uniform" ImageOpened="Picture_Opened" ImageFailed="Picture_Failed" />
        </Grid>
    </Border>
</UserControl>
