<Page
    x:Class="M3uPlayer.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:M3uPlayer.App.ViewModels"
    xmlns:l="using:M3uPlayer.App">
    <Page.Resources>
        <DataTemplate x:Key="SourceRowTemplate" x:DataType="vm:SourceRow">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}" Padding="16" Margin="0,0,0,8">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind Location, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind LastSuccessText, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ResultText, Mode=OneWay}" Visibility="{x:Bind HasResult, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind SkippedText, Mode=OneWay}" Visibility="{x:Bind HasSkipped, Mode=OneWay}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind AutoAddedText, Mode=OneWay}" Visibility="{x:Bind HasAutoAdded, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{x:Bind ErrorText, Mode=OneWay}" Visibility="{x:Bind HasError, Mode=OneWay}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <ProgressRing Width="20" Height="20" IsActive="{x:Bind ShowProgress, Mode=OneWay}" Visibility="{x:Bind ShowProgress, Mode=OneWay}"
                                          AutomationProperties.Name="{l:Tr Key=Settings_Refreshing}" />
                            <Button Tag="{x:Bind}" IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}" Visibility="{x:Bind IsEpg}" Click="MoveUp_Click"
                                    ToolTipService.ToolTip="{l:Tr Key=Settings_MoveUp}" AutomationProperties.Name="{l:Tr Key=Settings_MoveUp}">
                                <FontIcon Glyph="&#xE70E;" FontSize="14" />
                            </Button>
                            <Button Tag="{x:Bind}" IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}" Visibility="{x:Bind IsEpg}" Click="MoveDown_Click"
                                    ToolTipService.ToolTip="{l:Tr Key=Settings_MoveDown}" AutomationProperties.Name="{l:Tr Key=Settings_MoveDown}">
                                <FontIcon Glyph="&#xE70D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
                        <ComboBox Header="{l:Tr Key=Settings_RefreshEvery}" Tag="{x:Bind}" Width="140" ItemsSource="{x:Bind vm:IntervalChoice.Labels}"
                                  SelectedIndex="{x:Bind IntervalIndex, Mode=OneWay}"
                                  SelectionChanged="Interval_Changed" />
                        <ToggleSwitch Header="{l:Tr Key=Settings_AutoRefresh}" Tag="{x:Bind}" IsOn="{x:Bind AutoRefresh, Mode=OneWay}"
                                      OnContent="{l:Tr Key=Settings_On}" OffContent="{l:Tr Key=Settings_Off}" Toggled="Auto_Toggled" />
                        <Button Content="{l:Tr Key=Settings_RefreshNow}" Tag="{x:Bind}" IsEnabled="{x:Bind CanRefresh, Mode=OneWay}" Click="Refresh_Click"
                                VerticalAlignment="Bottom" />
                        <Button Content="{x:Bind RemoveLabel, Mode=OneWay}" Tag="{x:Bind}" Visibility="{x:Bind CanRemove, Mode=OneWay}" Click="Remove_Click"
                                VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="CategoryRowTemplate" x:DataType="vm:SettingsCategoryRow">
            <Grid ColumnSpacing="16" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{x:Bind CountText}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <CheckBox Grid.Column="2" Content="{l:Tr Key=Settings_CategoryPinned}" IsChecked="{x:Bind Pinned, Mode=OneWay}" Tag="{x:Bind}"
                          AutomationProperties.Name="{x:Bind PinnedName}" Click="CategoryPinned_Click" />
                <CheckBox Grid.Column="3" Content="{l:Tr Key=Settings_CategoryHidden}" IsChecked="{x:Bind Hidden, Mode=OneWay}" Tag="{x:Bind}"
                          AutomationProperties.Name="{x:Bind HiddenName}" Click="CategoryHidden_Click" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,24" Spacing="8" MaxWidth="960" HorizontalAlignment="Left">
            <TextBlock Text="{l:Tr Key=Settings_Title}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,8" />
            <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" Margin="0,0,0,16">
                <SelectorBarItem x:Name="GeneralItem" Text="{l:Tr Key=Settings_TabGeneral}" IsSelected="True" />
                <SelectorBarItem x:Name="PlaybackItem" Text="{l:Tr Key=Settings_TabPlayback}" />
                <SelectorBarItem x:Name="SourcesItem" Text="{l:Tr Key=Settings_TabSources}" />
                <SelectorBarItem x:Name="CategoriesItem" Text="{l:Tr Key=Settings_TabCategories}" />
                <SelectorBarItem x:Name="DataItem" Text="{l:Tr Key=Settings_TabData}" />
            </SelectorBar>

            <StackPanel x:Name="GeneralTab" Spacing="8">
                <ComboBox x:Name="LanguageBox" MinWidth="240" Header="{l:Tr Key=Settings_Language}" />
                <TextBlock Text="{l:Tr Key=Settings_LanguageRestart}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="ThemeBox" MinWidth="240" Header="{l:Tr Key=Settings_Theme}" Margin="0,16,0,0" />
            </StackPanel>

            <StackPanel x:Name="PlaybackTab" Spacing="8" Visibility="Collapsed">
                <ToggleSwitch x:Name="AutostartSwitch" Header="{l:Tr Key=Settings_Autostart}"
                              OnContent="{l:Tr Key=Settings_On}" OffContent="{l:Tr Key=Settings_Off}" />
                <ToggleSwitch x:Name="FullscreenSwitch" Header="{l:Tr Key=Settings_StartFullscreen}"
                              OnContent="{l:Tr Key=Settings_On}" OffContent="{l:Tr Key=Settings_Off}" />
                <ComboBox x:Name="BufferBox" MinWidth="240" Header="{l:Tr Key=Settings_Buffer}" Margin="0,16,0,0" />
                <ToggleSwitch x:Name="HwSwitch" Header="{l:Tr Key=Settings_HwDecoding}"
                              OnContent="{l:Tr Key=Settings_On}" OffContent="{l:Tr Key=Settings_Off}" />
                <TextBlock Text="{l:Tr Key=Settings_NextChannelNote}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="SeekBox" MinWidth="240" Header="{l:Tr Key=Settings_SeekStep}" Margin="0,16,0,0" />
                <ComboBox x:Name="HideBox" MinWidth="240" Header="{l:Tr Key=Settings_HideControls}" />
            </StackPanel>

            <StackPanel x:Name="SourcesTab" Spacing="8" Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="{l:Tr Key=Settings_Lists}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="AddPlaylistButton" Content="{l:Tr Key=Settings_AddList}" HorizontalAlignment="Right" Click="AddPlaylist_Click" />
                </Grid>
                <TextBlock x:Name="NoPlaylists" Text="{l:Tr Key=Settings_NoLists}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="PlaylistList" ItemTemplate="{StaticResource SourceRowTemplate}" />

                <Grid Margin="0,24,0,0">
                    <TextBlock Text="{l:Tr Key=Settings_EpgSources}" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button x:Name="AddEpgButton" Content="{l:Tr Key=Settings_AddEpg}" HorizontalAlignment="Right" Click="AddEpg_Click" />
                </Grid>
                <TextBlock x:Name="NoEpgs" Text="{l:Tr Key=Settings_NoEpgs}"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="EpgList" ItemTemplate="{StaticResource SourceRowTemplate}" />

                <ComboBox x:Name="DefaultIntervalBox" MinWidth="240" Header="{l:Tr Key=Settings_DefaultInterval}" Margin="0,24,0,0" />
            </StackPanel>

            <StackPanel x:Name="CategoriesTab" Spacing="8" Visibility="Collapsed">
                <TextBlock x:Name="NoCategories" Text="{l:Tr Key=Settings_NoCategories}" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl x:Name="CategoryRows" ItemTemplate="{StaticResource CategoryRowTemplate}" />
                <Button x:Name="ShowAllButton" Content="{l:Tr Key=Settings_ShowAllCategories}" Click="ShowAll_Click" Margin="0,16,0,0" />
            </StackPanel>

            <StackPanel x:Name="DataTab" Spacing="8" Visibility="Collapsed">
                <Button x:Name="ClearLogosButton" Content="{l:Tr Key=Settings_ClearLogos}" Click="ClearLogos_Click" />
                <TextBlock x:Name="LogosCleared" Text="{l:Tr Key=Settings_LogosCleared}" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="ClearAllButton" Content="{l:Tr Key=Settings_ClearAll}" Click="ClearAll_Click" Margin="0,16,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
