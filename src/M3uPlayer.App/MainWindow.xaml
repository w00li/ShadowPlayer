<Window
    x:Class="M3uPlayer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="using:M3uPlayer.App"
    Title="ShadowPlayer">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <NavigationView x:Name="Nav" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        OpenPaneLength="220" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="LiveItem" Content="{l:Tr Key=Main_Live}" Tag="live" Icon="Video" />
                <NavigationViewItem x:Name="SettingsItem" Content="{l:Tr Key=Main_Settings}" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>
            <Frame x:Name="Host" />
        </NavigationView>
        <!-- Over every page and the full-screen video, so a new version is never hidden behind a collapsed panel. -->
        <InfoBar x:Name="UpdateToast" Severity="Informational" IsClosable="False" IsOpen="{x:Bind Updates.IsBarOpen, Mode=OneWay}"
                 Message="{x:Bind Updates.Status, Mode=OneWay}" Width="360" Margin="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel Spacing="8" Margin="0,0,0,12">
                <ProgressBar Value="{x:Bind Updates.Percent, Mode=OneWay}" Maximum="100" Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{l:Tr Key=Update_Update}" Style="{ThemeResource AccentButtonStyle}" Click="Update_Click"
                            Visibility="{x:Bind Updates.CanUpdate, Mode=OneWay}" />
                    <Button Content="{l:Tr Key=Update_Later}" Click="UpdateLater_Click" Visibility="{x:Bind Updates.CanUpdate, Mode=OneWay}" />
                    <Button Content="{l:Tr Key=AddSource_Cancel}" Click="UpdateCancel_Click" Visibility="{x:Bind Updates.IsDownloading, Mode=OneWay}" />
                    <HyperlinkButton Content="{l:Tr Key=Update_WhatsNew}" NavigateUri="{x:Bind Updates.ReleasePage, Mode=OneWay}"
                                     Visibility="{x:Bind Updates.CanUpdate, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </InfoBar>
    </Grid>
</Window>
